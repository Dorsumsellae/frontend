# URL publique du backend FastAPI, appelee depuis le NAVIGATEUR.
# En dev local comme en Docker (ports publies), c'est l'URL vue par le navigateur :
#   http://localhost:8000
# NB : inlinee au build (prefixe NEXT_PUBLIC_). En Docker, la passer en build arg.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
